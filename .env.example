# Copy to .env and fill in. Never commit .env (it's gitignored).
# See README.md "Setup" for the full walkthrough of each service.

# --- Judge LLM (relevance filter) ---------------------------------------
# LOOKOUT_JUDGE_PROVIDER selects the backend: auto | anthropic | ollama | stub
#   auto     -> anthropic if ANTHROPIC_API_KEY is set, else stub (default)
#   anthropic -> paid Claude API, requires ANTHROPIC_API_KEY
#   ollama   -> free, local, requires `ollama serve` running (see README)
#   stub     -> free, deterministic regex heuristic, no LLM at all
LOOKOUT_JUDGE_PROVIDER=ollama
ANTHROPIC_API_KEY=
LOOKOUT_OLLAMA_HOST=http://localhost:11434
LOOKOUT_OLLAMA_MODEL=llama3.1:8b

# --- Redis (primary datastore + RediSearch vector dedup) ----------------
# Local Redis Stack via Docker (recommended, see README):
REDIS_URL=redis://localhost:6379

# --- Browserbase (optional; scraping already works via plain requests) --
# Leave LOOKOUT_USE_BROWSERBASE unset/0 unless a source needs real browser
# rendering or hits anti-bot walls that plain `requests` can't get past.
LOOKOUT_USE_BROWSERBASE=0
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
PHOENIX_URL=http://localhost:6006

# --- Notify (Report page delivery channels) ------------------------------
LOOKOUT_DISCORD_WEBHOOK=
LOOKOUT_WEBHOOK_URL=
